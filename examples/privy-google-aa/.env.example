VITE_PRIVY_APP_ID=
VITE_LNET_RPC_URL=http://34.69.184.205:4545
VITE_LNET_CHAIN_ID=648540
VITE_BUNDLER_URL=https://bundler.l-net.io
VITE_READ_RPC_URL=https://bundler.l-net.io
VITE_ENTRYPOINT_ADDRESS=0x9fD181236dA8c890bD5007b44B80E395E130c57D
VITE_FACTORY_ADDRESS=0x5589A0E344688976e473FD56BAe94411d9d56f67
# Prefilled in the "Storage contract" input; override with your own deployment.
VITE_STORAGE_ADDRESS=0xDcEA70eDDFA7EAB3590A1Ac7c00B48D36b4a13c6

# --- Session backend (server/token-server.mjs) ---
# Read by the Node backend only (no VITE_ prefix => never shipped to the browser).
# The backend logs into Keycloak with these, stores the access token in an
# HttpOnly cookie, and proxies bundler writes with the Bearer header.
KEYCLOAK_URL=https://auth.l-net.io
KEYCLOAK_REALM=naas-realm
KEYCLOAK_CLIENT_ID=naas-client
KEYCLOAK_CLIENT_SECRET=
NAAS_USERNAME=
NAAS_PASSWORD=
TOKEN_SERVER_HOST=127.0.0.1
TOKEN_SERVER_PORT=8787
# Where /api/bundler forwards writes; keep in sync with VITE_BUNDLER_URL.
BUNDLER_URL=https://bundler.l-net.io


ALLOWED_CALL_TARGETS=*

# Write policy for /api/bundler. Defaults come from the VITE_* values above, so
# one .env drives both sides. ALLOWED_CALL_TARGETS=* accepts any target contract;
# ALLOWED_INNER_CALLS=* accepts any inner call (both weaken the XSS blast radius).
# ENTRYPOINT_ADDRESS=0x9fD181236dA8c890bD5007b44B80E395E130c57D
# FACTORY_ADDRESS=0x5589A0E344688976e473FD56BAe94411d9d56f67
# ALLOWED_CALL_TARGETS=0xDcEA70eDDFA7EAB3590A1Ac7c00B48D36b4a13c6
# ALLOWED_INNER_CALLS=set(uint256)

# Write log (SQLite, via node:sqlite — no extra dependency). Every write the
# proxy handles is recorded, including the ones the policy rejects, and each row
# is settled later from the bundler receipt. GET /api/history returns the last N.
# A relative path resolves from server/, not from the shell's cwd.
# USEROP_LOG_DB=userops.db
# USEROP_LOG_LIMIT=10

# Optional: session cookie attributes. It is always a session cookie (no Max-Age),
# so browsers keep it in memory and never write the token to disk.
# SESSION_COOKIE_NAME=naas_session
# SESSION_COOKIE_PATH=/api
# SameSite=Strict works for the same-origin (Vite proxy) setup. A cross-origin
# frontend needs None + Secure, i.e. HTTPS on both sides.
# SESSION_COOKIE_SAMESITE=Strict
# SESSION_COOKIE_SECURE=true
# Fixes cookie signing across restarts (random per boot otherwise).
# SESSION_SECRET=

# Optional: override the frontend's API base (default /api via the Vite proxy).
# An absolute URL makes the calls cross-origin, which also needs
# TOKEN_ALLOWED_ORIGINS + SESSION_COOKIE_SAMESITE=None + HTTPS.
# VITE_API_BASE=/api
