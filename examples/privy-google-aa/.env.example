VITE_PRIVY_APP_ID=
VITE_LNET_RPC_URL=http://34.69.184.205:4545
VITE_LNET_CHAIN_ID=648540
VITE_BUNDLER_URL=https://bundler.l-net.io
VITE_READ_RPC_URL=https://bundler.l-net.io
VITE_ENTRYPOINT_ADDRESS=0x9fD181236dA8c890bD5007b44B80E395E130c57D
VITE_FACTORY_ADDRESS=0x5589A0E344688976e473FD56BAe94411d9d56f67
# Prefilled in the "Storage contract" input; override with your own deployment.
VITE_STORAGE_ADDRESS=0xDcEA70eDDFA7EAB3590A1Ac7c00B48D36b4a13c6

# --- Backend (server/api.mjs) ---
# One service serves the frontend and /api: in dev the handler is mounted inside
# Vite (server/vite-api.mjs), and on Vercel it is the api/[...path].js function.
# These vars have no VITE_ prefix => they are read server-side only and never
# shipped to the browser. On Vercel, set them as Environment Variables (the same
# names) — .env is not deployed.
# The backend logs into Keycloak with these, stores the access token in an
# HttpOnly cookie, and proxies bundler writes with the Bearer header.
KEYCLOAK_URL=https://auth.l-net.io
KEYCLOAK_REALM=naas-realm
KEYCLOAK_CLIENT_ID=naas-client
KEYCLOAK_CLIENT_SECRET=
NAAS_USERNAME=
NAAS_PASSWORD=
# Where /api/bundler forwards writes; keep in sync with VITE_BUNDLER_URL.
BUNDLER_URL=https://bundler.l-net.io


ALLOWED_CALL_TARGETS=*

# Write policy for /api/bundler. Defaults come from the VITE_* values above, so
# one .env drives both sides. ALLOWED_CALL_TARGETS=* accepts any target contract;
# ALLOWED_INNER_CALLS=* accepts any inner call (both weaken the XSS blast radius).
# ENTRYPOINT_ADDRESS=0x9fD181236dA8c890bD5007b44B80E395E130c57D
# FACTORY_ADDRESS=0x5589A0E344688976e473FD56BAe94411d9d56f67
# ALLOWED_CALL_TARGETS=0xDcEA70eDDFA7EAB3590A1Ac7c00B48D36b4a13c6
# ALLOWED_INNER_CALLS=set(uint256)

# Write log (SQLite, via node:sqlite — no extra dependency, needs Node >= 22.5).
# Every write the proxy handles is recorded, including the ones the policy rejects,
# and each row is settled later from the bundler receipt. GET /api/history returns
# the last N. A relative path resolves from server/, not from the shell's cwd.
# Deployed, the default moves to /tmp/userops.db — the only writable path on a
# serverless instance, and per-instance + wiped on cold start, so the history list
# there is a convenience, not durable storage (swap in a hosted DB for that).
# USEROP_LOG_DB=userops.db
# USEROP_LOG_LIMIT=10

# Optional: session cookie attributes. It is always a session cookie (no Max-Age),
# so browsers keep it in memory and never write the token to disk.
# SESSION_COOKIE_NAME=naas_session
# SESSION_COOKIE_PATH=/api
# SameSite=Strict works because the frontend and /api share one origin. A
# cross-origin frontend needs None + Secure, i.e. HTTPS on both sides.
# SESSION_COOKIE_SAMESITE=Strict
# Secure is implied on a deployment (HTTPS); set it explicitly to false only to
# opt out, e.g. when testing a deployed build over plain HTTP.
# SESSION_COOKIE_SECURE=true
# Fixes cookie signing across restarts (random per boot otherwise). On serverless
# each instance would otherwise sign with its own key, so a cold start silently
# invalidates live sessions — set this in the Vercel env.
# SESSION_SECRET=

# Optional: forces the "deployed" defaults (no Host allowlist, Secure cookie,
# /tmp write log) when hosting somewhere that does not set VERCEL=1.
# DEPLOYED=true

# Optional: override the frontend's API base (default /api on this same origin).
# An absolute URL makes the calls cross-origin, which also needs
# TOKEN_ALLOWED_ORIGINS + SESSION_COOKIE_SAMESITE=None + HTTPS.
# VITE_API_BASE=/api
# TOKEN_ALLOWED_ORIGINS=https://app.example.com
